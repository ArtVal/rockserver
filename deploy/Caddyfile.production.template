{$ROCKSERVER_DOMAIN} {
    encode gzip
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data:"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        -Server
    }
    @api path /api/v1/* /health/*
    handle @api {
        reverse_proxy rockserver:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Rockserver-Proxy {$ROCKSERVER_TRUSTED_PROXY_TOKEN}
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
